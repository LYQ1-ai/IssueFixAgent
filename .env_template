# ============================================================================
# CodeAgentRL 环境配置模板 (.env_template)
# ----------------------------------------------------------------------------
# 用法：
#   1. 复制为 .env 并按需修改：  cp .env_template .env
#   2. 运行前加载（任选其一）：
#        source .env                     # bash/zsh
#        export $(grep -v '^#' .env | xargs)   # 需保证值不含空格/特殊字符
#   3. 或直接在启动命令前内联设置：CODEAGENTRL_IMAGE=... python xxx.py
#
# 说明：
#   - 所有变量都有代码内默认值，不设置也能运行；
#   - 配置类（agent/init_env.py 的 EnvConfig、agent/shell_tool.py 的
#     ShellToolConfig）实例化时读取环境变量；显式传入构造参数的优先级更高；
#   - 布尔值取值：1 / true / yes / on 视为 True，其余视为 False；
#   - 整数值取十进制整数，非法或为空时回落默认值。
# ============================================================================


# ----------------------------------------------------------------------------
# [通用] docker CLI
# ----------------------------------------------------------------------------
# 作用：init_env 创建/管理环境容器、shell_tool 在容器内执行只读命令时，
#       调用的 docker 命令路径（两个模块共用）。
# 默认：docker（即 PATH 中的 docker）
# 示例：MSWEA_DOCKER_EXECUTABLE=/usr/bin/docker
MSWEA_DOCKER_EXECUTABLE=docker


# ----------------------------------------------------------------------------
# [执行环境管理器 agent/init_env.py -> EnvConfig]
# ----------------------------------------------------------------------------
# 环境创建流程：检查本地 zip 缓存 -> docker run 基础镜像 -> 容器内放仓库
# （zip 缓存命中则 docker cp+解压，否则 git clone）-> git checkout 指定 commit。

# 基础镜像
# 作用：每个 (repo, commit) 环境容器基于该镜像启动（容器内需有 git/unzip，
#       缺失会自动 apt 安装；建议使用预装 git/unzip/ripgrep 的镜像以加速创建）。
# 默认：python:3.11-slim
# 示例：CODEAGENTRL_IMAGE=python:3.11
# 通用镜像：见 agent/Dockerfile（docker build -t codeagentrl-agent:ubuntu24 -f agent/Dockerfile .）
# 示例：CODEAGENTRL_IMAGE=codeagentrl-agent:ubuntu24
CODEAGENTRL_IMAGE=python:3.11-slim

# 容器内仓库路径（工作目录）
# 作用：仓库克隆/解压后存放的容器内目录，也是外部 Agent 执行命令的 cwd。
# 默认：/repo
# 注意：若修改，请同步修改 shell 工具的 MSWEA_WORKDIR，保持一致。
CODEAGENTRL_WORKDIR=/repo

# 容器内运行用户
# 作用：docker run 的 --user 参数（uid:gid 或用户名）；留空表示以 root 运行。
# 默认：（空 -> root）
# 示例：CODEAGENTRL_USER=1000:1000
#CODEAGENTRL_USER=

# 是否在容器内安装 ripgrep
# 作用：codescout 风格 agent 依赖 rg 做代码搜索；首次创建容器时若容器内没有
#       rg 会通过 apt 安装（增加创建耗时，可关闭或改用预装镜像）。
# 默认：true
CODEAGENTRL_INSTALL_RIPGREP=true

# 是否强制容器内 apt 走 IPv4
# 作用：部分主机 IPv6 路由不可达但 DNS 优先返回 AAAA，导致容器内 apt-get update
#       长时间挂起；强制 IPv4 并加 http 超时可规避（同时作用于 apt 安装 git/unzip/rg）。
# 默认：true
CODEAGENTRL_APT_FORCE_IPV4=true

# 仓库 zip 缓存目录
# 作用：配置后，创建容器前若缓存中不存在 <仓库名（/ 替换为 __）>.zip
#       （如 django__django.zip，内含完整 git 克隆含 .git 历史），会先在
#       宿主机 git clone 并把仓库打成 zip 存入缓存，之后统一走
#       docker cp + 解压 + git checkout（与缓存命中路径完全一致）；
#       未配置（空）则回退为容器内 git clone。
#       缓存可由 `python -m agent.init_env cache <repo>` 预生成，或由
#       get_env 在未命中时自动补齐（宿主机需可访问 github.com 且装有 git）。
# 默认：（空 -> 禁用 zip 缓存，容器内 git clone）
# 示例：CODEAGENTRL_REPO_CACHE_DIR=/data/repo_cache
#CODEAGENTRL_REPO_CACHE_DIR=

# 容器内 git clone 超时（秒）
# 作用：git clone 远程仓库的最大等待时间；大仓库可调大。
# 默认：600
CODEAGENTRL_CLONE_TIMEOUT=600

# 普通 docker exec 命令超时（秒）
# 作用：checkout、解压、docker cp 等常规容器操作的单次超时。
# 默认：120
CODEAGENTRL_EXEC_TIMEOUT=120

# 容器内环境初始化超时（秒）
# 作用：首次创建容器时 apt-get update/install（git/unzip/ripgrep）的超时。
# 默认：600
CODEAGENTRL_SETUP_TIMEOUT=600

# docker run / 拉取镜像超时（秒）
# 作用：docker run 启动容器（含镜像拉取）的最大等待时间。
# 默认：300
CODEAGENTRL_PULL_TIMEOUT=300

# 容器名前缀
# 作用：生成的容器名形如 <前缀>-<仓库>-<commit8>-<随机6位>，便于识别/清理。
# 默认：codeagentrl
CODEAGENTRL_NAME_PREFIX=codeagentrl


# ----------------------------------------------------------------------------
# [只读 shell 工具 agent/shell_tool.py -> ShellToolConfig]
# ----------------------------------------------------------------------------
# 工具只做命令级只读校验，并在 init_env 提供的容器里 docker exec 执行命令。

# docker exec 工作目录
# 作用：在容器内执行命令时的 cwd（仓库根目录）。
# 默认：/repo
# 注意：应与 CODEAGENTRL_WORKDIR 保持一致。
MSWEA_WORKDIR=/repo

# 单条命令超时（秒）
# 作用：agent 每次 bash 调用的最大执行时间，超时在容器内 kill。
# 默认：30
MSWEA_TIMEOUT=30

# 命令输出截断长度（字符）
# 作用：返回给 agent 的输出做 head+tail 截断，防止上下文爆炸。
# 默认：10000
MSWEA_MAX_OUTPUT_CHARS=10000

# 同一容器的最大并发 docker exec 数
# 作用：限制对同一环境容器的并发命令数（0 = 不限，高并发 rollout 时建议保持）。
# 默认：4
MSWEA_MAX_CONCURRENT=4

# 严格只读命令白名单
# 作用：true 时除通用只读校验外，还只允许白名单内的命令名（严格模式）。
# 默认：false
MSWEA_READONLY_ALLOWLIST_ONLY=false

# 是否允许写入容器 /tmp
# 作用：true 时允许 agent 在 /tmp 下创建临时文件（其余写操作一律拒绝）。
# 默认：true
MSWEA_ALLOW_TMP_WRITES=true


# ----------------------------------------------------------------------------
# [基础 agent agent/base_agent.py -> RepoAgent]
# ----------------------------------------------------------------------------
# RepoAgent 在 init_env 获取的指定容器中运行 mini-swe-agent（不修改其源码）：
# 执行前 get_env 获取容器，执行完成后（含异常）release_env 释放。
# 提示词/模型配置默认复用 mini-swe-agent 自带 config/mini.yaml。

# 模型名
# 作用：mini-swe-agent 的 get_model 读取的默认模型（也接受 RepoAgent(model_name=...)）。
# 默认：（空 -> 必须显式传入 model_name 或设置本变量）
# 示例：MSWEA_MODEL_NAME=anthropic/claude-sonnet-4-5-20250929
#MSWEA_MODEL_NAME=

# minisweagent 包源码目录
# 作用：未 pip 安装 mini-swe-agent 时，base_agent 把该目录加入 sys.path 以导入
#       minisweagent（默认取项目内 ref_papers/mini-swe-agent/src，可指向移动后的目录）。
# 默认：（空 -> ref_papers/mini-swe-agent/src）
#MSWEA_PACKAGE_SRC=/home/lyq/PycharmProjects/CodeAgentRL/ref_papers/mini-swe-agent/src

# 容器内工作目录（与 init_env 的 CODEAGENTRL_WORKDIR 保持一致）
# 作用：attach 容器时 docker exec 的 cwd（仓库根目录）。
# 默认：/repo
MSWEA_WORKDIR=/repo


# ----------------------------------------------------------------------------
# [Phoenix 追踪（可选）agent/tracing.py + agent/base_agent.py -> RepoAgent]
# ----------------------------------------------------------------------------
# RepoAgent(phoenix_tracing=True) 或 run(phoenix_tracing=...) 开启后，每次执行期间
# 的所有 litellm 模型调用会上报到 Phoenix（OTLP），结果返回本次执行的 trace_id；
# 可按 trace_id 用 agent.tracing.export_trace 从服务端导出执行轨迹（MCTS 采样数据）。
# 服务端跑在独立 conda 环境 phoenix（arize-phoenix），见 README §7。

# OTLP collector 地址（gRPC）
# 作用：Agent 进程上报 span 的目标地址（phoenix serve 的 OTLP gRPC 端口）。
# 默认：http://localhost:4317
# 示例：PHOENIX_COLLECTOR_ENDPOINT=http://10.0.0.5:4317
#PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# Phoenix 项目名
# 作用：span 归属的 Phoenix 项目（UI 按项目分组查看）。
# 默认：codeagentrl
#PHOENIX_PROJECT=codeagentrl

# Phoenix REST API 基址（导出 trace 用）
# 作用：export_trace 拉取执行轨迹的 REST 地址（phoenix serve 的 Web UI 端口）。
# 默认：http://localhost:6006
#PHOENIX_REST_URL=http://localhost:6006

# API key（服务端启用认证时必填）
# 作用：导出 / 上报时的 Bearer 认证；本机默认关闭认证则无需设置。
#PHOENIX_API_KEY=


# ----------------------------------------------------------------------------
# [测试（可选）]
# ----------------------------------------------------------------------------

# 集成测试用基础镜像
# 作用：pytest --run-integration 创建真实环境容器时使用的镜像，可覆盖
#       CODEAGENTRL_IMAGE，避免在测试中走一遍 apt 安装。
# 默认：python:3.11-slim
# 示例：CODEAGENTRL_TEST_IMAGE=python:3.11
#CODEAGENTRL_TEST_IMAGE=python:3.11-slim

# ----------------------------------------------------------------------------
# [PRM（阶段 2 / M4）GPU 选择 —— prm/env.py]
# ----------------------------------------------------------------------------
# 作用：指定 PRM 的 probe / 训练 / 评估用哪张（或哪几张）GPU。
#       由各 CLI 入口（python -m prm.* 的 main）在开头装载，早于 torch/CUDA 初始化，
#       因此进程内 cuda:0 就是这里选中的第一张卡——**不要在 CLI 里写 cuda:1
#       这类物理卡号**（用 --device cuda 即可，或直接不传）。
# 格式：单卡填物理卡号；多卡用逗号分隔（本项目 PRM 训练只用单卡）
# 默认：不设置 = 全部卡可见（进程默认用物理卡 0）
# 示例：CUDA_VISIBLE_DEVICES=1
CUDA_VISIBLE_DEVICES=0
